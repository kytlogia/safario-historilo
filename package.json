{
  "name": "safario-historilo",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "description": "Safariのブラウズ履歴データベースを読み込み、訪問履歴を詳細に確認できるWebアプリ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kytlogia/safario-historilo.git"
  },
  "homepage": "https://github.com/kytlogia/safario-historilo",
  "bugs": {
    "url": "https://github.com/kytlogia/safario-historilo/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.21.0",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "[ -f .nuxt/eslint.config.mjs ] || nuxt prepare && eslint .",
    "lint:fix": "[ -f .nuxt/eslint.config.mjs ] || nuxt prepare && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron": "pnpm build && electron .",
    "electron:build": "pnpm build && electron-builder --mac --publish=never",
    "electron:build:win": "pnpm build && electron-builder --win --publish=never"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.5.2",
    "sql.js": "^1.14.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9",
    "vue-router": "^5.2.0",
    "vuetify": "4.1.9",
    "vuetify-nuxt-module": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.kytlogia.safario-historilo",
    "productName": "Safari History Detail",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": "output"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
