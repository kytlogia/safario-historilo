# Nitro auto-load reads Safari History.db directly from the local filesystem.
# Default path: ~/Library/Safari/History.db
# Leave this unset/empty to use the default. If you do set it, `~` is
# expanded to your home directory automatically.
NUXT_HISTORY_DB_PATH=

# SECURITY: leave this unset/false unless you intentionally want to allow
# non-local requests to /api/local-history. Enabling it is discouraged and at
# your own risk because other machines could probe or access local History.db.
NUXT_HISTORY_DB_ALLOW_REMOTE=false

# DEVELOPMENT ONLY: `nuxt dev` uses an internal proxy, so auto-load stays
# disabled unless you explicitly trust that proxy. This flag is ignored in
# production builds. Do not enable it when exposing `nuxt dev` to LAN/containers.
NUXT_HISTORY_DB_TRUST_DEV_PROXY=false
